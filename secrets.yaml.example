# Copy to secrets.yaml and fill in.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
# Generate: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "base64-32-byte-key"
ota_password: "some-long-random-string"
# Password for the fallback hotspot (min 8 chars)
fallback_ap_password: "fallback-password"
